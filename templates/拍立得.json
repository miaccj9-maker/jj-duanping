{
    "name":  "拍立得",
    "commentsInside":  false,
    "css":  ".be-card.be-custom{background:#fafafa;padding:14px 14px 70px 14px;box-shadow:0 2px 8px rgba(0,0,0,.15),0 0 0 1px rgba(0,0,0,.04);position:relative;width:340px;box-sizing:border-box;font-family:-apple-system,\u0027PingFang SC\u0027,\u0027Microsoft YaHei\u0027,sans-serif;}.be-card.be-custom .be-head{display:none!important;}.be-card.be-custom .be-quote{display:block;margin:0;padding:0;background:#1a1a1a;color:#f5f5f5;font-size:15px;line-height:1.6;padding:20px 18px;min-height:280px;box-sizing:border-box;white-space:pre-wrap;word-break:break-word;}.be-card.be-custom .be-source{position:absolute;bottom:14px;left:14px;right:14px;display:flex;flex-direction:column;gap:2px;}.be-card.be-custom .be-source .title{font-size:13px;color:#333;font-weight:600;cursor:pointer;}.be-card.be-custom .be-source .chapter{display:none!important;}.be-card.be-custom .be-source .author{position:absolute;bottom:14px;right:14px;font-size:11px;color:#888;text-align:right;cursor:pointer;line-height:1.3;}.be-card.be-custom .be-watermark{position:absolute;bottom:38px;right:14px;font-size:10px;color:#aaa;cursor:pointer;text-align:right;line-height:1.3;}.be-card.be-custom .be-avatar{display:none!important;}.be-card.be-custom .be-name{display:none!important;}.be-card.be-custom .be-date{display:none!important;}.be-card.be-custom .be-comment{display:none!important;}",
    "comments":  ".be-comment{background:#f5f5f5;border-radius:6px;padding:8px 10px;margin-top:6px;}.be-comment-name{color:#576b95;font-size:12px;font-weight:600;}.be-comment-text{color:#333;font-size:13px;line-height:1.5;}",
    "night":  ".be-card.be-custom{background:#1a1a1a!important;box-shadow:0 2px 8px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.06)!important;}.be-card.be-custom .be-quote{background:#2a2a2a!important;color:#e8e8e8!important;}.be-card.be-custom .be-source .title{color:#e8e8e8!important;}.be-card.be-custom .be-source .author{color:#999!important;}.be-card.be-custom .be-watermark{color:#666!important;}"
}
