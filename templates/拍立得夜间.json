{
  "name": "拍立得夜间",
  "commentsInside": false,
  "css": ".be-card.be-custom{background:#1a1a1a;padding:22px 22px 52px 22px;box-shadow:0 4px 16px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.08);position:relative;width:340px;box-sizing:border-box;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;}.be-card.be-custom .be-head{position:absolute;bottom:62px;right:40px;z-index:3;text-align:right;pointer-events:none;}.be-card.be-custom .be-avatar{display:none!important;}.be-card.be-custom .be-name{font-size:11px;color:rgba(255,255,255,.85);display:block!important;cursor:pointer;pointer-events:auto;}.be-card.be-custom .be-date{font-size:10px;color:rgba(255,255,255,.6);display:block!important;cursor:pointer;pointer-events:auto;}.be-card.be-custom .be-quote{display:block;margin:0;padding:22px 20px 44px 20px;background:#2a2a2a;color:#e8e8e8;font-size:15px;line-height:1.65;min-height:280px;box-sizing:border-box;white-space:pre-wrap;word-break:break-word;position:relative;}.be-card.be-custom .be-source{position:absolute;bottom:0;left:0;right:0;height:52px;display:flex;align-items:center;justify-content:center;padding:0 15%;box-sizing:border-box;}.be-card.be-custom .be-source .title{font-size:16px;color:#f0f0f0;font-weight:600;cursor:pointer;text-align:center;width:100%;line-height:1.25;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}.be-card.be-custom .be-source .chapter{display:none!important;}.be-card.be-custom .be-source .author{display:none!important;}.be-card.be-custom .be-watermark{display:none!important;}.be-card.be-custom .be-comment{display:none!important;}",
  "comments": ".be-comment{background:#2a2a2a;border-radius:6px;padding:8px 10px;margin-top:6px;}.be-comment-name{color:#7ab8ff;font-size:12px;font-weight:600;}.be-comment-text{color:#e8e8e8;font-size:13px;line-height:1.5;}",
  "night": ""
}
